# Browser (Next.js) — copy to `.env.local`. All optional.
#
# The API ships inside this app and is called on the same origin, so nothing is
# needed locally or on the site server.
#
# NEXT_PUBLIC_API_URL=https://equicare.example.in   # a separately hosted backend
# NEXT_PUBLIC_DEMO_MODE=1    # force bundled mock data, no API calls. This is ON
#                            # automatically for a Vercel build without
#                            # NEXT_PUBLIC_API_URL — i.e. today's public demo.

# Bearer token — only needed if the backend sets AUTH_API_TOKEN.

# ---------------------------------------------------------------------------
# Backend (server/) env vars, for reference — set these in the server's own
# environment, not here:
#
#   PORT=8080  HOST=127.0.0.1     # defaults; HOST=0.0.0.0 to serve the barn LAN
#   EQUICARE_DATA_DIR=/var/lib/equicare   # JSON store location (default ./server/data)
#   DATABASE_URL=postgres://...   # unset => JSON file store (dev)
#                                 # set   => Postgres (run server/schema.sql first)
#   AUTH_API_TOKEN=<secret>       # unset => /api/* is open
#   AUTH_INGEST_TOKEN=<secret>    # unset => /ingest/* is open
#
# Edge agent (edge/) env vars:
#   EQUICARE_API=http://127.0.0.1:8080
#   EQUICARE_TOKEN=<same as AUTH_INGEST_TOKEN>

# --- notifications (optional) ---
# POST each newly-raised alert as JSON to this URL (Slack / n8n / WhatsApp gateway).
# Unset => alerts are logged only.
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# NOTIFY_MIN_SEVERITY=alert      # alert (default) | warn | ok
# NOTIFY_DISABLED=1              # log only, never deliver

# --- authentication ---
# First boot creates an admin and prints a generated password once.
# Set these to choose the credentials yourself instead.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me
#
# Machine access (not browser-delivered):
# AUTH_API_TOKEN=…        server-to-server callers of /api/*
# AUTH_INGEST_TOKEN=…     legacy shared token for /ingest/* (the command-line agent).
#                         Edge boxes and push devices normally use their own
#                         tokens, issued on the Hardware page.
#
# NOTE: there is deliberately no NEXT_PUBLIC_*_TOKEN. NEXT_PUBLIC_ vars are
# compiled into the JS bundle, so a token there is readable by anyone who opens
# devtools. The
# browser authenticates with a per-user session from /auth/login instead.

# --- hardware integration (Hardware page) ---
# Camera passwords are encrypted at rest (AES-256-GCM). Unset => a random key is
# generated once into <data dir>/secret.key (mode 0600). Set this from a secret
# manager to keep the key away from the data directory.
# CAMERA_SECRET_KEY=…
#
# The server only connects to site-network addresses (private, loopback,
# link-local). Set to 1 only if a camera genuinely has a public address.
# EQUICARE_CAMERA_ALLOW_PUBLIC=1
#
# Idle camera sessions are logged out after this many ms (default 60000), so
# the server does not hold one of the camera's few session slots.
# EQUICARE_CAMERA_IDLE_MS=60000
