# /etc/equicare/site.env on the stable's site server (owner root, mode 600).

# Where readings, raw motion recordings and footage live (back this up).
EQUICARE_DATA_DIR=/var/lib/equicare

# The relay the SIM hubs send to (DEPLOY_CLOUD.md). With both set, the server
# pulls every 15 s. The key is the relay's RELAY_KEY.
EQUICARE_RELAY_URL=https://relay.example.in
EQUICARE_RELAY_KEY=

# Optional.
# EQUICARE_SENSOR_TICK_MS=15000      # the pull / raw-analysis tick (0 = off)
# EQUICARE_RAW_DAYS=30               # raw recordings kept on disk
# DATABASE_URL=postgres://…          # the Postgres store (India region) — past ~300 000 readings the JSON store drops the oldest
# HOST=0.0.0.0                       # listen on the stable network, not only this machine (npm start uses 127.0.0.1)
# PORT=8080
