# /etc/systemd/system/equicare-relay.service — the relay for the SIM hubs
# (server/relay.mjs, DEPLOY_CLOUD.md). Listens on localhost only; Caddy in
# front of it terminates TLS.
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now equicare-relay
#   journalctl -u equicare-relay -f

[Unit]
Description=EquiCare relay (store-and-forward for the wearable hubs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# RELAY_KEY=... (root-owned, mode 600). See relay.env.example.
EnvironmentFile=/etc/equicare/relay.env
ExecStart=/usr/bin/node /opt/equicare-relay/relay.mjs --port 8787 --host 127.0.0.1 --data /var/lib/equicare-relay
Restart=on-failure
RestartSec=5

# Its own throwaway user, and a private data directory
# (/var/lib/equicare-relay) that only it can read.
DynamicUser=yes
StateDirectory=equicare-relay
StateDirectoryMode=0700
UMask=0077

# Nothing else on the machine is its business.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
